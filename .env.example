# Password for the dashboard login page.
DASHBOARD_PASSWORD=

# Bearer token for the apply agent and CSV/Notion sync.
# Send as Authorization: Bearer $SYNC_TOKEN or X-Sync-Token.
SYNC_TOKEN=

# Neon Postgres connection string. Required in production.
# Local `npm run dev` uses a file-backed Postgres in data/pglite when this is unset.
DATABASE_URL=

# Optional. Vercel Cron sends this as a bearer token to GET /api/discover.
CRON_SECRET=
